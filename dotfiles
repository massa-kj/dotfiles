#!/usr/bin/env bash
# dotfiles
# Main CLI entry point for dotfiles management

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_ROOT="$SCRIPT_DIR"

# Load logger for error messages
source "$DOTFILES_ROOT/core/lib/logger.sh"

# Usage
usage() {
    cat <<EOF
Usage: dotfiles <command> [options]

A declarative environment management system.

Available commands:
  apply <profile>    Apply a dotfiles profile
  plan  <profile>    Show what apply would do (no changes made)

Options:
  plan --verbose     Also list noop (already up-to-date) features

Examples:
  dotfiles apply profiles/wsl.yaml
  dotfiles plan  profiles/wsl.yaml
  dotfiles plan  profiles/wsl.yaml --verbose

EOF
    exit 1
}

# Parse command
if [[ $# -lt 1 ]]; then
    usage
fi

COMMAND="$1"
shift

# Dispatch to command implementation
case "$COMMAND" in
    apply)
        exec "$DOTFILES_ROOT/cmd/apply.sh" "$@"
        ;;
    plan)
        exec "$DOTFILES_ROOT/cmd/plan.sh" "$@"
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        log_error "Unknown command: $COMMAND"
        echo ""
        usage
        ;;
esac
